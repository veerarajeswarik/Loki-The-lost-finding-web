# ─────────────────────────────────────────────────────────────
# LOKII CLIENT ENV — copy to .env and fill in.
# All VITE_ vars are exposed to the browser (public by design).
# Leave Firebase blank to use DEV AUTH MODE (see src/services/firebase.js).
# ─────────────────────────────────────────────────────────────

# Backend API base URL
VITE_API_BASE_URL=http://localhost:5000/api

# Firebase Web config (Project settings > General > Your apps)
# Missing -> client runs in DEV AUTH MODE (mock login, no real Firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Cloud Messaging web push (Project settings > Cloud Messaging)
VITE_FIREBASE_VAPID_KEY=

# EmailJS (email alerts) — https://www.emailjs.com
# Missing -> email sends are skipped (in-app notifications still work)
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
