# ─────────────────────────────────────────────────────────────
# LOKII SERVER ENV — copy to .env and fill in.
# Every external service is OPTIONAL: leave blank to run in
# graceful-fallback/dev mode (see server/config/env.js).
# ─────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas (required for persistence; falls back to erroring if unreachable)
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/lokii?retryWrites=true&w=majority

# Google Gemini (AI matching + reward recommendations)
# Missing -> heuristic matching + canned reward resources
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Firebase Admin SDK (verifies client ID tokens)
# Provide the FULL service-account JSON as a single-line string, OR
# place the file at server/serviceAccountKey.json and set the path below.
# Missing -> DEV AUTH MODE (insecure; trusts x-dev-uid / x-dev-* headers)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Cloudinary (image storage; signed uploads)
# Missing -> placeholder image URLs are returned
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=lokii

# Firebase Cloud Messaging (push) — server uses Admin SDK creds above.
# Missing -> push sends are logged no-ops (in-app notifications still saved)

# Tunables
MATCH_CONFIDENCE_THRESHOLD=60
VERIFICATION_PASS_THRESHOLD=70
